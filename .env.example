# Public values: configure in Vercel per environment.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_EXAMPLE"
# Optional only when a real push delivery worker and VAPID keys exist:
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
# Never place SUPABASE_SECRET_KEY, service role, or VAPID private key in browser-exposed variables.
